
@model SpotifyNet.Models.PlaylistDetailViewModel

@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = Model.Name;

    string inicial = string.IsNullOrWhiteSpace(Model.Owner)
        ? "U"
        : Model.Owner.Substring(0, 1).ToUpperInvariant();
}

<link rel="stylesheet"
      href="~/css/playlist.css"
      asp-append-version="true" />
<link rel="stylesheet"
      href="~/css/playlist-avanzada.css"
      asp-append-version="true" />

<style>
    /* PASO 24 - CONTROLES DE PLAYLIST */

    .p24-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        padding: 20px 22px;
        background: #191119;
    }

    .p24-primary,
    .p24-secondary {
        font-family: inherit;
        font-weight: 800;
        cursor: pointer;
        transition: transform .12s, background .12s;
    }

    .p24-primary {
        padding: 11px 18px;
        border: 0;
        border-radius: 24px;
        background: #1ed760;
        color: #000;
        font-size: 13px;
    }

    .p24-secondary {
        padding: 10px 15px;
        border: 1px solid #666;
        border-radius: 24px;
        background: transparent;
        color: white;
        font-size: 12px;
    }

    .p24-primary:hover,
    .p24-secondary:hover {
        transform: scale(1.03);
    }

    .p24-danger {
        border-color: #934242;
        color: #ffabab;
    }

    .p24-status {
        padding: 0 22px 14px;
        color: #b7b7b7;
        background: #191119;
        font-size: 12px;
        line-height: 1.5;
    }

    .p24-error {
        color: #ff9999;
    }

    .p24-saved {
        padding: 22px;
        background: linear-gradient(#24121d, #121212 180px);
    }

    .p24-saved h2 {
        margin: 0 0 8px;
        font-size: 20px;
    }

    .p24-hint {
        margin: 0 0 17px;
        font-size: 12px;
        color: #aaa;
        line-height: 1.5;
    }

    .p24-saved .pdetail-table-head,
    .p24-saved .pdetail-track-row {
        display: grid;
        grid-template-columns:
            24px
            minmax(170px, 1.6fr)
            minmax(95px, .8fr)
            minmax(105px, .8fr)
            98px;
        gap: 9px;
        align-items: center;
    }

    .p24-saved .pdetail-track-row {
        min-height: 51px;
        cursor: default;
    }

    .p24-saved .pdetail-track-main {
        cursor: pointer;
    }

    .p24-saved .pdetail-track-main:hover
    .pdetail-track-title {
        text-decoration: underline;
    }

    .p24-actions-cell {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .p24-like,
    .p24-more {
        border: 0;
        background: transparent;
        color: #aaa;
        cursor: pointer;
        font-family: inherit;
    }

    .p24-like {
        padding: 4px;
        font-size: 20px;
    }

    .p24-like.is-liked {
        color: #1ed760;
    }

    .p24-more {
        padding: 4px 7px;
        font-size: 20px;
        font-weight: bold;
        letter-spacing: 1px;
        border-radius: 5px;
    }

    .p24-like:hover,
    .p24-more:hover {
        color: white;
    }

    .p24-more:hover {
        background: #ffffff20;
    }

    .p24-icon {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 4px;
        background: #245a4b;
        color: #1ed760;
        font-size: 19px;
    }

    .p24-empty {
        padding: 26px;
        text-align: center;
        border: 1px dashed #444;
        border-radius: 8px;
        color: #b5b5b5;
        font-size: 13px;
    }

    .p24-demo-label {
        padding: 15px 0 12px;
        color: #aaa;
        font-size: 12px;
    }

    /* MENU CONTEXTUAL */
    .p24-menu,
    .p24-submenu {
        position: fixed;
        z-index: 99999;
        width: 240px;
        max-height: min(520px, 70vh);
        overflow: auto;
        padding: 5px;
        border: 1px solid #484848;
        border-radius: 6px;
        background: #282828;
        color: #fff;
        box-shadow: 0 12px 35px rgba(0,0,0,.75);
        font-family: Arial, sans-serif;
    }

    .p24-menu[hidden],
    .p24-submenu[hidden] {
        display: none !important;
    }

    .p24-menu-btn {
        width: 100%;
        min-height: 39px;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 10px 9px;
        border: 0;
        border-radius: 3px;
        background: transparent;
        color: #eee;
        text-align: left;
        font-family: inherit;
        font-size: 12px;
        cursor: pointer;
    }

    .p24-menu-btn:hover,
    .p24-menu-btn:focus-visible {
        background: #3e3e3e;
        outline: none;
    }

    .p24-menu-icon {
        display: inline-grid;
        place-items: center;
        width: 18px;
        flex-shrink: 0;
        color: #b3b3b3;
        font-size: 17px;
    }

    .p24-menu-arrow {
        margin-left: auto;
        color: #bbb;
    }

    .p24-menu-divider {
        height: 1px;
        margin: 5px 3px;
        background: #4a4a4a;
    }

    .p24-menu-heading {
        padding: 9px 10px;
        font-size: 12px;
        font-weight: 750;
        color: white;
    }

    .p24-menu-search {
        display: block;
        width: calc(100% - 10px);
        margin: 5px;
        padding: 10px;
        border: 1px solid #484848;
        border-radius: 4px;
        background: #3a3a3a;
        color: white;
        font-family: inherit;
        font-size: 12px;
        outline: none;
    }

    .p24-menu-search:focus {
        border-color: #a5a5a5;
    }

    .p24-menu-list {
        max-height: 310px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #666 #282828;
    }

    .p24-menu-empty {
        padding: 13px;
        color: #aaa;
        font-size: 12px;
    }

    .p24-menu-btn.is-selected {
        color: #1ed760;
    }

    .p24-mini-notice {
        padding: 7px;
        color: #aaa;
        font-size: 11px;
        line-height: 1.5;
    }

    @@media (max-width: 1050px) {
        .p24-saved .pdetail-table-head,
        .p24-saved .pdetail-track-row {
            grid-template-columns:
                24px
                minmax(150px, 1fr)
                minmax(90px, .7fr)
                90px;
        }

        .p24-saved .pdetail-table-head > div:nth-child(4),
        .p24-saved .pdetail-track-date {
            display: none;
        }
    }

    @@media (max-width: 700px) {
        .p24-saved {
            padding: 14px;
        }

        .p24-actions {
            padding: 14px;
        }

        .p24-status {
            padding: 0 14px 12px;
        }

        .p24-saved .pdetail-table-head,
        .p24-saved .pdetail-track-row {
            grid-template-columns:
                20px
                minmax(110px, 1fr)
                75px;
        }

        .p24-saved .pdetail-table-head > div:nth-child(3),
        .p24-saved .pdetail-track-album {
            display: none;
        }

        .p24-actions-cell {
            gap: 0;
        }

        .p24-menu,
        .p24-submenu {
            width: min(245px, calc(100vw - 20px));
        }
    }
</style>

<div class="pdetail-page" id="playlistPage">

    <!-- CABECERA -->
    <section class="pdetail-hero"
             style="--hero-color:@Model.BannerColor;">

        <div class="pdetail-cover">
            <img src="@Url.Content(Model.Cover)"
                 alt="@Model.Name" />
        </div>

        <div class="pdetail-meta">

            <div class="pdetail-type">
                @Model.Type
            </div>

            <h1>@Model.Name</h1>

            <div class="pdetail-ownerline">

                <span class="pdetail-avatar">
                    @inicial
                </span>

                <strong>@Model.Owner</strong>

                @if (!string.IsNullOrWhiteSpace(Model.SavesText))
                {
                    <span>• @Model.SavesText</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.TrackCountText))
                {
                    <span id="playlistRealCount">• @Model.TrackCountText</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.DurationText))
                {
                    <span>• @Model.DurationText</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="pdetail-description">
                    @Model.Description
                </p>
            }

        </div>
    </section>

    <!-- BARRA DE REPRODUCCION -->
    <section class="pdetail-toolbar">

        <button type="button"
                class="pdetail-play-btn"
                id="playlistPlayAll"
                title="Reproducir playlist">
            ▶
        </button>

        <span class="pdetail-small-cover">
            <img src="@Url.Content(Model.Cover)"
                 alt="@Model.Name" />
        </span>

        <button type="button"
                class="pdetail-tool-btn"
                id="playlistRefresh"
                title="Actualizar canciones">
            ↻
        </button>

        <a href="/"
           class="pdetail-tool-btn"
           title="Inicio">
            ⌂
        </a>

        <div class="pdetail-view-mode">
            Lista ☰
        </div>

    </section>

    <!-- ACCIONES -->
    <section class="p24-actions">

        <button type="button"
                class="p24-primary"
                id="playlistAddAudio">
            + Añadir canciones
        </button>

        <button type="button"
                class="p24-secondary"
                id="playlistRename"
                hidden>
            Renombrar playlist
        </button>

        <button type="button"
                class="p24-secondary p24-danger"
                id="playlistDelete"
                hidden>
            Eliminar playlist
        </button>

        <button type="button" class="p24-secondary" id="playlistEditDetails" hidden>
            <span aria-hidden="true">✎</span> Editar detalles
        </button>
        <button type="button" class="p24-secondary" id="playlistChangeCover" hidden>
            <span aria-hidden="true">▧</span> Cambiar portada
        </button>
        <input type="file" id="playlistCoverFile" accept="image/jpeg,image/png,image/webp" hidden />

        <input type="file"
               id="playlistAudioFiles"
               accept=".mp3,.wav,.ogg,.m4a,audio/*"
               multiple
               hidden />

        <form id="playlistToken" hidden>
            @Html.AntiForgeryToken()
        </form>

    </section>

    <div id="playlistStatus"
         class="p24-status"
         role="status"
         aria-live="polite">
        Cargando canciones...
    </div>

    <!-- EDITOR DE PLAYLIST: solo para listas del usuario -->
    <dialog id="playlistEditDialog" class="pb-dialog">
        <form method="dialog" id="playlistEditForm">
            <h2>Editar información de la playlist</h2>
            <label for="playlistEditName">Nombre</label>
            <input id="playlistEditName" maxlength="100" minlength="2" required />
            <label for="playlistEditDescription">Descripción</label>
            <textarea id="playlistEditDescription" maxlength="600" rows="4"
                placeholder="¿Qué música tiene esta playlist?"></textarea>
            <div class="pb-dialog-actions">
                <button type="button" id="playlistCancelDetails">Cancelar</button>
                <button type="submit" value="save" class="pb-save">Guardar cambios</button>
            </div>
        </form>
    </dialog>

    <!-- BLOQUE C: PRIVACIDAD, ENLACES Y COLABORADORES -->
    <section class="sc-management" id="socialManagement" data-slug="@Model.Slug" hidden>
        <div class="sc-management-header">
            <h3>Compartir esta playlist</h3><span class="sc-tag" id="socialPrivacyLabel">Privada</span>
        </div>
        <p>Las listas son privadas por defecto. Solo se comparten cuando tú lo decidas.</p>
        <div class="sc-actions">
            <button type="button" id="socialTogglePublic" class="sc-button">Hacer pública</button>
            <button type="button" id="socialCopy" class="sc-button">Copiar enlace</button>
            <a href="/Social/MiEspacio" class="sc-button">Mi espacio</a>
        </div>
        <form id="socialInviteForm">
            <label for="socialInviteEmail">Invitar colaborador</label>
            <input id="socialInviteEmail" type="email" required maxlength="256" placeholder="correo@ejemplo.com" />
            <button type="submit" class="sc-green">Invitar usuario</button>
        </form>
        <div id="socialMembers"></div>
        <p id="socialFeedback" class="sc-feedback" role="status" aria-live="polite"></p>
    </section>

    <!-- CANCIONES REALES -->
    <section class="p24-saved">

        <h2>Canciones de tu biblioteca</h2>

        <p class="p24-hint">
            Pasa el cursor por una canción.
            Utiliza el corazón o los tres puntos
            para agregarla a otras playlists.
        </p>

        <div class="pb-tools">
            <label class="pb-search-wrap">
                <span aria-hidden="true">⌕</span>
                <input id="playlistTrackSearch" type="search"
                       placeholder="Buscar en esta playlist" autocomplete="off"
                       aria-label="Buscar canciones en esta playlist" />
            </label>
            <label class="pb-order-wrap" for="playlistTrackSort">
                <span>Ordenar:</span>
                <select id="playlistTrackSort">
                    <option value="manual">Orden personalizado</option>
                    <option value="title-asc">Título (A–Z)</option>
                    <option value="title-desc">Título (Z–A)</option>
                    <option value="artist-asc">Artista (A–Z)</option>
                    <option value="artist-desc">Artista (Z–A)</option>
                    <option value="date-desc">Más recientes</option>
                    <option value="date-asc">Más antiguas</option>
                </select>
            </label>
        </div>
        <p class="pb-order-hint" id="playlistOrderHint" hidden>
            Arrastra las canciones o utiliza ↑ y ↓ para guardar tu orden personalizado.
        </p>

        <div class="pdetail-table-head">

            <div>#</div>
            <div>Título</div>
            <div>Álbum</div>
            <div>Fecha en que se agregó</div>
            <div>Acciones</div>

        </div>

        <div id="playlistSavedTracks"></div>

        <div id="playlistEmpty"
             class="p24-empty"
             hidden>
            Todavía no tienes canciones guardadas aquí.
            Puedes añadir MP3 o agregar canciones
            desde otras playlists.
        </div>

    </section>

    <!-- CANCIONES DE DEMOSTRACION -->
    @if (Model.Tracks.Count > 0)
    {
        <section class="pdetail-table"
                 id="playlistDemoSection">

            <div class="p24-demo-label">
                Canciones de referencia.
                Para reproducirlas, necesitas añadir
                archivos de audio a tu biblioteca.
            </div>

            <div class="pdetail-table-head">
                <div>#</div>
                <div>Título</div>
                <div>Álbum</div>
                <div>Fecha en que se agregó</div>
                <div>◷</div>
            </div>

            <div class="pdetail-table-body">

                @foreach (var track in Model.Tracks)
                {
                    <div class="pdetail-track-row">

                        <div class="pdetail-track-number">
                            @track.Number
                        </div>

                        <div class="pdetail-track-main">

                            <img src="@Url.Content(track.Cover)"
                                 alt="@track.Title" />

                            <div class="pdetail-track-info">

                                <span class="pdetail-track-title">
                                    @track.Title
                                </span>

                                <span class="pdetail-track-artist">
                                    @track.Artist
                                </span>

                            </div>

                        </div>

                        <div class="pdetail-track-album">
                            @track.Album
                        </div>

                        <div class="pdetail-track-date">
                            @track.AddedDate
                        </div>

                        <div class="pdetail-track-duration">
                            @track.Duration
                        </div>

                    </div>
                }

            </div>
        </section>
    }

    <!-- RECOMENDACIONES -->
    @if (Model.Recommendations.Count > 0)
    {
        <section class="pdetail-recommendations">

            <h2>Recomendaciones</h2>

            <p>
                Basadas en esta playlist de demostración
            </p>

            <div class="pdetail-rec-list">

                @foreach (var item in Model.Recommendations)
                {
                    <div class="pdetail-rec-row">

                        <div class="pdetail-rec-left">

                            <img src="@Url.Content(item.Cover)"
                                 alt="@item.Title" />

                            <div>
                                <strong>@item.Title</strong>
                                <span>@item.Artist</span>
                            </div>

                        </div>

                        <div class="pdetail-rec-album">
                            @item.Album
                        </div>

                        <div class="pdetail-rec-duration">
                            @item.Duration
                        </div>

                    </div>
                }

            </div>

        </section>
    }

    <!-- PIE DE PAGINA -->
    <section class="pdetail-footer">

        <div class="pdetail-footer-grid">

            <div>
                <h4>SpotifyNet</h4>
                <a href="/">Inicio</a>
                <a href="/">Mi biblioteca</a>
            </div>

            <div>
                <h4>Tu música</h4>
                <a href="/">Playlists</a>
                <a href="/">Canciones</a>
            </div>

            <div>
                <h4>Proyecto</h4>
                <a href="/">ASP.NET Core MVC</a>
                <a href="/">SQLite</a>
            </div>

            <div>
                <h4>Cuenta</h4>
                <span style="color:#aaa;font-size:12px;">
                    Sesión protegida
                </span>
            </div>

        </div>

        <div class="pdetail-footer-bottom">
            <span>SpotifyNet · Proyecto universitario</span>
            <span>2026</span>
        </div>

    </section>

</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {

    const slug = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model.Slug)
    );

    const nombreInicial = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model.Name)
    );

    let portada = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Url.Content(Model.Cover))
    );

    const $ = id => document.getElementById(id);

    // Al navegar internamente, se elimina el menú antiguo.
    if (window.__spotifyPlaylistCleanup) {
        window.__spotifyPlaylistCleanup();
    }

    const abortador = new AbortController();

    const lista = $("playlistSavedTracks");
    const vacio = $("playlistEmpty");
    const estado = $("playlistStatus");

    const token = document.querySelector(
        '#playlistToken input[name="__RequestVerificationToken"]'
    )?.value || "";

    let canciones = [];
    let esPersonal = false;
    let puedeEditar = false;
    let descripcionActual = "";
    let nombreActual = nombreInicial;
    let ordenActual = "manual";
    let busquedaActual = "";
    const comparar = new Intl.Collator("es", { sensitivity: "base", numeric: true });
    let cancionMenu = null;

    // ==========================================
    // MENÚ CONTEXTUAL
    // ==========================================

    const menu = document.createElement("div");
    menu.className = "p24-menu";
    menu.hidden = true;

    const submenu = document.createElement("div");
    submenu.className = "p24-submenu";
    submenu.hidden = true;

    document.body.append(menu, submenu);

    function limpiarMenu() {
        menu.remove();
        submenu.remove();
        abortador.abort();
    }

    window.__spotifyPlaylistCleanup = limpiarMenu;

    document.addEventListener(
        "spotifynet:navegacion",
        function () {
            if (!document.getElementById("playlistPage")) {
                limpiarMenu();
            }
        },
        { signal: abortador.signal }
    );

    function cerrarMenus() {
        menu.hidden = true;
        submenu.hidden = true;
        cancionMenu = null;
    }

    document.addEventListener(
        "pointerdown",
        function (evento) {
            if (!menu.contains(evento.target) &&
                !submenu.contains(evento.target) &&
                !evento.target.closest(".p24-more")) {
                cerrarMenus();
            }
        },
        { signal: abortador.signal }
    );

    document.addEventListener(
        "keydown",
        function (evento) {
            if (evento.key === "Escape") {
                cerrarMenus();
            }
        },
        { signal: abortador.signal }
    );

    function posicionarMenu(caja, referencia, ancho = 240) {
        const margen = 10;

        caja.style.width = ancho + "px";

        caja.hidden = false;

        const alto = caja.offsetHeight;

        const izquierda = Math.max(
            margen,
            Math.min(
                referencia.left,
                window.innerWidth - ancho - margen
            )
        );

        const arriba = Math.max(
            margen,
            Math.min(
                referencia.bottom + 5,
                window.innerHeight - alto - margen
            )
        );

        caja.style.left = izquierda + "px";
        caja.style.top = arriba + "px";
    }

    function separador() {
        const div = document.createElement("div");
        div.className = "p24-menu-divider";
        return div;
    }

    function opcion(texto, icono, accion) {
        const boton = document.createElement("button");

        boton.type = "button";
        boton.className = "p24-menu-btn";

        const simbolo = document.createElement("span");
        simbolo.className = "p24-menu-icon";
        simbolo.textContent = icono;

        const nombre = document.createElement("span");
        nombre.textContent = texto;

        boton.append(simbolo, nombre);

        if (accion) {
            boton.addEventListener("click", accion);
        }

        return boton;
    }

    function mensaje(texto, error = false) {
        estado.textContent = texto;
        estado.classList.toggle("p24-error", error);
    }

    async function peticionPost(url, campos) {
        const formulario = new FormData();

        Object.entries(campos).forEach(([clave, valor]) => {
            formulario.append(clave, valor);
        });

        const respuesta = await fetch(url, {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "RequestVerificationToken": token
            },
            body: formulario
        });

        const datos = await respuesta.json().catch(
            () => ({})
        );

        if (!respuesta.ok) {
            throw new Error(
                datos.error ||
                "No se pudo completar la operación."
            );
        }

        return datos;
    }

    function datosParaReproductor() {
        return canciones.map(cancion => ({
            id: cancion.id,
            title: cancion.title,
            artist: cancion.artist,
            url: cancion.url,
            cover: portada,
            local: false
        }));
    }

    function reproducir(indice) {
        if (canciones.length === 0) {
            mensaje("Primero añade una canción a la playlist.");
            return;
        }

        const reproductor = window.SpotifyNetPlayer;

        if (!reproductor) {
            mensaje(
                "El reproductor no está disponible.",
                true
            );
            return;
        }

        reproductor.playTracks(
            datosParaReproductor(),
            indice
        );

        mensaje(
            "Reproduciendo: " + canciones[indice].title
        );
    }

    // ==========================================
    // FAVORITOS
