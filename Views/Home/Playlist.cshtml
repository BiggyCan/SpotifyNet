         "KISS ME KISS ME KISS ME AGAIN"]
    ];

    async function mostrarSubmenu(cancion) {
        if (!cancion) return;

        submenu.replaceChildren();
        submenu.hidden = false;

        const titulo = document.createElement("div");
        titulo.className = "p24-menu-heading";
        titulo.textContent = "Agregar a playlist";

        const buscador = document.createElement("input");
        buscador.type = "search";
        buscador.className = "p24-menu-search";
        buscador.placeholder = "Busca una playlist";
        buscador.autocomplete = "off";

        const nueva = opcion(
            "Nueva playlist",
            "+",
            async function () {
                const nombre = prompt(
                    "Nombre de tu nueva playlist:",
                    "Mi nueva playlist"
                );

                if (nombre === null) return;

                if (nombre.trim().length < 2) {
                    mensaje(
                        "Escribe un nombre de al menos 2 caracteres.",
                        true
                    );
                    return;
                }

                try {
                    const resultado = await peticionPost(
                        "/Biblioteca/CrearLista",
                        { nombre: nombre.trim() }
                    );

                    await peticionPost(
                        "/Biblioteca/AgregarALista",
                        {
                            id: cancion.id,
                            slug: resultado.slug
                        }
                    );

                    await window.SpotifyNetLibraryRefresh?.();

                    cerrarMenus();

                    mensaje(
                        "Playlist creada y canción agregada. " +
                        "La música continúa sonando."
                    );

                } catch (error) {
                    mensaje(error.message, true);
                }
            }
        );

        const listaDestinos = document.createElement("div");
        listaDestinos.className = "p24-menu-list";

        submenu.append(
            titulo,
            buscador,
            nueva,
            separador(),
            listaDestinos
        );

        const base = destinosReferencia.map(item => ({
            slug: item[0],
            name: item[1]
        }));

        try {
            const respuesta = await fetch(
                "/Biblioteca/MisListas",
                { credentials: "same-origin" }
            );

            if (respuesta.ok) {
                const personales = await respuesta.json();

                personales.forEach(item => {
                    base.push({
                        slug: item.slug,
                        name: item.name
                    });
                });
            }

        } catch (error) {
            console.error(
                "No se pudieron cargar las playlists personales.",
                error
            );
        }

        const destinos = Array.from(
            new Map(
                base.map(item => [item.slug, item])
            ).values()
        );

        function dibujarDestinos() {
            const termino = buscador.value
                .trim()
                .toLocaleLowerCase();

            listaDestinos.replaceChildren();

            const visibles = destinos.filter(item =>
                item.name.toLocaleLowerCase().includes(termino)
            );

            if (visibles.length === 0) {
                const vacio = document.createElement("div");

                vacio.className = "p24-menu-empty";
                vacio.textContent =
                    "No se encontraron playlists.";

                listaDestinos.appendChild(vacio);
                return;
            }

            visibles.forEach(item => {
                const boton = opcion(
                    item.name,
                    "♫",
                    function () {
                        agregarALista(cancion, item.slug);
                    }
                );

                if (item.slug === slug) {
                    boton.classList.add("is-selected");
                    boton.title =
                        "Esta canción ya está en la playlist actual";
                }

                listaDestinos.appendChild(boton);
            });
        }

        buscador.addEventListener(
            "input",
            dibujarDestinos
        );

        dibujarDestinos();

        // Submenú junto al menú principal,
        // preferentemente a su izquierda.
        const rect = menu.getBoundingClientRect();

        submenu.style.left = Math.max(
            10,
            rect.left - 255
        ) + "px";

        submenu.style.top = Math.max(
            10,
            Math.min(
                rect.top,
                window.innerHeight -
                Math.min(submenu.offsetHeight, 520) - 10
            )
        ) + "px";
    }

    async function quitarCancion(cancion) {
        if (!confirm(
            "¿Quitar esta canción de la playlist?"
        )) return;

        try {
            await peticionPost(
                "/Biblioteca/EliminarCancion",
                {
                    id: cancion.id,
                    slug: slug
                }
            );

            window.SpotifyNetPlayer?.stop();

            cerrarMenus();
            await cargarCanciones(false);

            mensaje("Canción quitada de esta playlist.");

        } catch (error) {
            mensaje(error.message, true);
        }
    }

    function abrirMenu(cancion, boton) {
        cerrarMenus();

        cancionMenu = cancion;

        menu.replaceChildren();

        const agregar = opcion(
            "Agregar a playlist",
            "+",
            function () {
                mostrarSubmenu(cancion);
            }
        );

        const flecha = document.createElement("span");
        flecha.className = "p24-menu-arrow";
        flecha.textContent = "›";
        agregar.appendChild(flecha);

        agregar.addEventListener(
            "mouseenter",
            function () {
                if (submenu.hidden) {
                    mostrarSubmenu(cancion);
                }
            }
        );

        const favorito = opcion(
            cancion.isLiked
                ? "Quitar de Tus me gusta"
                : "Agregar a Tus me gusta",
            cancion.isLiked ? "♥" : "♡",
            function () {
                cambiarFavorito(cancion);
            }
        );

        const cola = opcion(
            "Agregar a la fila de reproducción",
            "☷",
            function () {
                const correcto =
                    window.SpotifyNetPlayer?.queueTrack({
                        title: cancion.title,
                        artist: cancion.artist,
                        url: cancion.url,
                        cover: portada,
                        local: false
                    });

                cerrarMenus();

                mensaje(
                    correcto
                        ? "Canción añadida a la fila."
                        : "No se pudo añadir a la fila.",
                    !correcto
                );
            }
        );

        const siguiente = opcion(
            "Reproducir a continuación",
            "⏭",
            function () {
                const correcto = window.SpotifyNetPlayer?.playNextTrack({
                    id: cancion.id,
                    title: cancion.title,
                    artist: cancion.artist,
                    url: cancion.url,
                    cover: portada,
                    local: false
                });
                cerrarMenus();
                mensaje(
                    correcto ? "Canción colocada a continuación." : "No se pudo añadir la canción.",
                    !correcto
                );
            }
        );

        const quitar = opcion(
            "Quitar de esta playlist",
            "×",
            function () {
                quitarCancion(cancion);
            }
        );

        menu.append(
            agregar,
            favorito,
            siguiente,
            cola,
            separador(),
            quitar
        );

        const rect = boton.getBoundingClientRect();

        posicionarMenu(menu, rect);
    }

    // ==========================================
    // CONSTRUIR FILAS DE CANCIONES
    // ==========================================

    function crearFila(cancion, indice, numeroVisible = indice + 1) {
        const fila = document.createElement("div");
        fila.className = "pdetail-track-row";
        fila.dataset.trackId = cancion.id;
        const editableOrden = puedeEditar && ordenActual === "manual" && !busquedaActual;
        fila.draggable = editableOrden;
        fila.classList.toggle("pb-sortable", editableOrden);
        if (editableOrden) {
            fila.addEventListener("dragstart", e => {
                e.dataTransfer.setData("text/plain", cancion.id);
                e.dataTransfer.effectAllowed = "move";
                fila.classList.add("pb-dragging");
            });
            fila.addEventListener("dragend", () => fila.classList.remove("pb-dragging"));
            fila.addEventListener("dragover", e => {
                e.preventDefault();
                e.dataTransfer.dropEffect = "move";
            });
            fila.addEventListener("drop", async e => {
                e.preventDefault();
                const desde = e.dataTransfer.getData("text/plain");
                if (!desde || desde === cancion.id) return;
                const a = canciones.findIndex(x => x.id === desde);
                const b = canciones.findIndex(x => x.id === cancion.id);
                if (a < 0 || b < 0) return;
                await moverCancion(a, b);
            });
        }

        const numero = document.createElement("div");
        numero.className = "pdetail-track-number";
        numero.textContent = numeroVisible;

        const principal = document.createElement("div");
        principal.className = "pdetail-track-main";
        principal.title = "Reproducir " + cancion.title;

        const icono = document.createElement("span");
        icono.className = "p24-icon";
        icono.textContent = "♫";

        const info = document.createElement("div");
        info.className = "pdetail-track-info";

        const titulo = document.createElement("span");
        titulo.className = "pdetail-track-title";
        titulo.textContent = cancion.title;

        const artista = document.createElement("span");
        artista.className = "pdetail-track-artist";
        artista.textContent = cancion.artist;

        info.append(titulo, artista);
        principal.append(icono, info);

        principal.addEventListener("click", function () {
            reproducir(indice);
        });

        const album = document.createElement("div");
        album.className = "pdetail-track-album";
        album.textContent = cancion.album || "Sin álbum";

        const fecha = document.createElement("div");
        fecha.className = "pdetail-track-date";
        fecha.textContent = cancion.addedDate;

        const acciones = document.createElement("div");
        acciones.className = "p24-actions-cell";

        const corazon = document.createElement("button");
        corazon.type = "button";
        corazon.className = "p24-like";
        corazon.textContent = cancion.isLiked ? "♥" : "♡";
        corazon.title = cancion.isLiked
            ? "Quitar de Tus me gusta"
            : "Agregar a Tus me gusta";

        if (cancion.isLiked) {
            corazon.classList.add("is-liked");
        }

        corazon.addEventListener("click", function () {
            cambiarFavorito(cancion);
        });

        const mas = document.createElement("button");
        mas.type = "button";
        mas.className = "p24-more";
        mas.textContent = "···";
        mas.title = "Más opciones";

        mas.addEventListener("click", function () {
            abrirMenu(cancion, mas);
        });

        if (editableOrden) {
            const arriba = document.createElement("button");
            arriba.type = "button";
            arriba.className = "pb-move";
            arriba.textContent = "↑";
            arriba.title = "Mover hacia arriba";
            arriba.disabled = indice === 0;
            arriba.addEventListener("click", () => moverCancion(indice, indice - 1));
            const abajo = document.createElement("button");
            abajo.type = "button";
            abajo.className = "pb-move";
            abajo.textContent = "↓";
            abajo.title = "Mover hacia abajo";
            abajo.disabled = indice === canciones.length - 1;
            abajo.addEventListener("click", () => moverCancion(indice, indice + 1));
            acciones.append(arriba, abajo);
        }
        acciones.append(corazon, mas);

        fila.append(
            numero,
            principal,
            album,
            fecha,
            acciones
        );

        return fila;
    }

    function fechaOrdenable(fecha) {
        const partes = (fecha || "").split("/");
        return partes.length === 3
            ? `${partes[2]}${partes[1]}${partes[0]}` : "";
    }

    function cancionesVisibles() {
        const term = busquedaActual.toLocaleLowerCase("es");
        const visibles = canciones.filter(c =>
            `${c.title} ${c.artist} ${c.album || ""} ${nombreActual}`.toLocaleLowerCase("es").includes(term)
        );
        if (ordenActual !== "manual") {
            visibles.sort((a,b) => {
                if (ordenActual.startsWith("title"))
                    return comparar.compare(a.title, b.title) * (ordenActual.endsWith("desc") ? -1 : 1);
                if (ordenActual.startsWith("artist"))
                    return comparar.compare(a.artist, b.artist) * (ordenActual.endsWith("desc") ? -1 : 1);
                if (ordenActual === "date-asc")
                    return fechaOrdenable(a.addedDate).localeCompare(fechaOrdenable(b.addedDate));
                return fechaOrdenable(b.addedDate).localeCompare(fechaOrdenable(a.addedDate));
            });
        }
        return visibles;
    }

    async function moverCancion(origen, destino) {
        if (!puedeEditar || ordenActual !== "manual" || busquedaActual ||
            destino < 0 || destino >= canciones.length || origen === destino) return;
        const anteriores = [...canciones];
        const [mover] = canciones.splice(origen, 1);
        canciones.splice(destino, 0, mover);
        dibujarCanciones();
        try {
            const respuesta = await fetch("/Biblioteca/GuardarOrden", {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify({ slug, ids: canciones.map(c => c.id) })
            });
            const datos = await respuesta.json().catch(() => ({}));
            if (!respuesta.ok) throw new Error(datos.error || "No se pudo guardar el orden.");
            mensaje("Orden de la playlist guardado en SQLite.");
        } catch (error) {
            canciones = anteriores;
            dibujarCanciones();
            mensaje(error.message, true);
        }
    }

    function dibujarCanciones() {
        lista.replaceChildren();
        const visibles = cancionesVisibles();
        visibles.forEach((cancion, indice) => {
            const indiceOriginal = canciones.findIndex(c => c.id === cancion.id);
            lista.appendChild(crearFila(cancion, indiceOriginal, indice + 1));
        });
        vacio.hidden = visibles.length > 0;
        vacio.textContent = busquedaActual
            ? "No hay canciones que coincidan con esta búsqueda."
            : "Todavía no tienes canciones guardadas aquí. Puedes añadir MP3 o agregar canciones desde otras playlists.";
        $("playlistOrderHint").hidden = !(puedeEditar && ordenActual === "manual" && !busquedaActual);
        const demo = $("playlistDemoSection");
        if (demo) demo.hidden = canciones.length > 0 || slug === "tus-me-gusta" || !!busquedaActual;
    }

    function actualizarMiniaturas() {
        document.querySelectorAll("[data-playlist-slug]").forEach(card => {
            if (card.dataset.playlistSlug !== slug) return;
            const miniatura = card.querySelector(".u-lib-art, .u-quick-cover, .u-album-art");
            if (miniatura) {
                miniatura.style.backgroundImage = `url("${portada}")`;
                miniatura.style.backgroundSize = "cover";
                miniatura.style.backgroundPosition = "center";
            }
        });
    }

    function actualizarVistaDetalles(datos) {
        puedeEditar = !!datos.canEdit;
        descripcionActual = datos.description || "";
        if (datos.name) nombreActual = datos.name;
        if (datos.coverUrl) {
            // Cache-busting: se actualiza incluso si ya existía una portada en la sesión.
            portada = datos.coverUrl + (datos.coverUrl.includes("?") ? "&" : "?") + "v=" + Date.now();
            document.querySelectorAll("#playlistPage .pdetail-cover img, #playlistPage .pdetail-small-cover img")
                .forEach(img => { img.src = portada; });
            actualizarMiniaturas();
        }
        const titulo = document.querySelector("#playlistPage .pdetail-meta h1");
        if (titulo) titulo.textContent = nombreActual;
        const desc = document.querySelector("#playlistPage .pdetail-description");
        if (desc) desc.textContent = descripcionActual || (esPersonal ? "Tu playlist personal." : "Lista de ejemplo de SpotifyNet.");
        $("playlistEditDetails").hidden = !puedeEditar;
        $("playlistChangeCover").hidden = !puedeEditar;
        $("playlistRename").hidden = true;
    }

    async function cargarCanciones(mostrarEstado = true) {
        try {
            const respuesta = await fetch(
                "/Biblioteca/Canciones?slug=" +
                encodeURIComponent(slug),
                {
                    method: "GET",
                    credentials: "same-origin"
                }
            );

            if (!respuesta.ok) {
                throw new Error(
                    "No se pudo cargar la biblioteca."
                );
            }

            const datos = await respuesta.json();

            canciones = datos.tracks || [];
            const contadorReal = document.getElementById("playlistRealCount");
            if (contadorReal) contadorReal.textContent = "• " + canciones.length + " canciones guardadas";
            esPersonal = !!datos.isCustom;
            actualizarVistaDetalles(datos);
            $("playlistDelete").hidden = !esPersonal;

            if (slug === "tus-me-gusta") {
                $("playlistAddAudio").hidden = true;
            }

            dibujarCanciones();

            if (mostrarEstado) {
                mensaje(
                    canciones.length === 0
                        ? "Esta playlist no tiene canciones guardadas."
                        : canciones.length +
                          " canción(es) guardada(s)."
                );
            }

        } catch (error) {
            mensaje(error.message, true);
        }
    }

    // ==========================================
    // AÑADIR ARCHIVOS MP3
    // ==========================================

    $("playlistAddAudio").addEventListener(
        "click",
        function () {
            $("playlistAudioFiles").click();
        }
    );

    $("playlistAudioFiles").addEventListener(
        "change",
        async function () {
            const archivos = Array.from(this.files || []);

            if (archivos.length === 0) return;

            $("playlistAddAudio").disabled = true;

            let guardadas = 0;
            const errores = [];

            for (const archivo of archivos) {
                mensaje("Guardando " + archivo.name + "...");

                try {
                    await peticionPost(
                        "/Biblioteca/Subir",
                        {
                            slug: slug,
                            nombre: nombreActual,
                            archivo: archivo
                        }
                    );

                    guardadas++;

                } catch (error) {
                    errores.push(
                        archivo.name + ": " + error.message
                    );
                }
            }

            this.value = "";
            $("playlistAddAudio").disabled = false;

            await cargarCanciones(false);

            if (errores.length > 0) {
                mensaje(
                    "Guardadas: " + guardadas +
                    ". Errores: " + errores.join(" | "),
                    true
                );
            } else {
                mensaje(
                    guardadas +
                    " canción(es) guardada(s) correctamente."
                );
            }
        }
    );

