    $("playlistRename").addEventListener(
        "click",
        async function () {
            if (!esPersonal) return;

            const nuevoNombre = prompt(
                "Nuevo nombre de la playlist:",
                nombreActual
            );

            if (nuevoNombre === null) return;

            if (nuevoNombre.trim().length < 2) {
                mensaje("El nombre es demasiado corto.", true);
                return;
            }

            try {
                await peticionPost(
                    "/Biblioteca/RenombrarLista",
                    {
                        slug: slug,
                        nombre: nuevoNombre.trim()
                    }
                );

                nombreActual = nuevoNombre.trim();

                const titulo =
                    document.querySelector(
                        "#playlistPage .pdetail-meta h1"
                    );

                if (titulo) {
                    titulo.textContent = nombreActual;
                }

                document.title =
                    nombreActual + " - SpotifyNet";

                await window.SpotifyNetLibraryRefresh?.();
                await cargarCanciones(false);

                mensaje(
                    "Playlist renombrada sin detener la música."
                );

            } catch (error) {
                mensaje(error.message, true);
            }
        }
    );

    // ==========================================
    // ELIMINAR PLAYLIST PERSONAL
    // ==========================================

    $("playlistDelete").addEventListener(
        "click",
        async function () {
            if (!esPersonal) return;

            if (!confirm(
                "¿Eliminar esta playlist? Las canciones " +
                "compartidas con otras listas se conservarán."
            )) return;

            try {
                const resultado = await peticionPost(
                    "/Biblioteca/EliminarLista",
                    { slug: slug }
                );

                await window.SpotifyNetLibraryRefresh?.();

                cerrarMenus();

                if (window.SpotifyNetNavigate) {
                    await window.SpotifyNetNavigate(
                        resultado.url || "/"
                    );
                } else {
                    window.location.href =
                        resultado.url || "/";
                }

            } catch (error) {
                mensaje(error.message, true);
            }
        }
    );


    // BLOQUE B: filtros, edición de datos y subida de carátula
    $("playlistTrackSearch")?.addEventListener("input", e => {
        busquedaActual = e.target.value.trim();
        dibujarCanciones();
    });
    $("playlistTrackSort")?.addEventListener("change", e => {
        ordenActual = e.target.value;
        dibujarCanciones();
    });
    $("playlistEditDetails")?.addEventListener("click", () => {
        if (!puedeEditar) return;
        $("playlistEditName").value = nombreActual;
        $("playlistEditDescription").value = descripcionActual;
        $("playlistEditDialog").showModal();
    });
    $("playlistCancelDetails")?.addEventListener("click", () => {
        $("playlistEditDialog").close();
    });
    $("playlistEditForm")?.addEventListener("submit", async e => {
        e.preventDefault();
        const nombre = $("playlistEditName").value.trim();
        const descripcion = $("playlistEditDescription").value.trim();
        if (nombre.length < 2 || nombre.length > 100 || descripcion.length > 600) {
            mensaje("Verifica los datos del formulario.", true); return;
        }
        try {
            const datos = await peticionPost("/Biblioteca/EditarDetalles", { slug, nombre, descripcion });
            nombreActual = datos.name;
            descripcionActual = datos.description;
            const titulo = document.querySelector("#playlistPage .pdetail-meta h1");
            if (titulo) titulo.textContent = nombreActual;
            const desc = document.querySelector("#playlistPage .pdetail-description");
            if (desc) desc.textContent = descripcionActual;
            document.title = nombreActual + " - SpotifyNet";
            $("playlistEditDialog").close();
            await window.SpotifyNetLibraryRefresh?.();
            dibujarCanciones();
            mensaje("Detalles de la playlist guardados.");
        } catch (error) { mensaje(error.message, true); }
    });
    $("playlistChangeCover")?.addEventListener("click", () => {
        if (puedeEditar) $("playlistCoverFile").click();
    });
    $("playlistCoverFile")?.addEventListener("change", async function() {
        const archivo = this.files?.[0];
        this.value = "";
        if (!archivo) return;
        if (!/^image\/(jpeg|png|webp)$/.test(archivo.type) || archivo.size > 5 * 1024 * 1024) {
            mensaje("Selecciona JPG, PNG o WEBP de hasta 5 MB.", true); return;
        }
        try {
            const datos = await peticionPost("/Biblioteca/SubirPortada", { slug, archivo });
            portada = datos.coverUrl + (datos.coverUrl.includes("?") ? "&" : "?") + "v=" + Date.now();
            document.querySelectorAll("#playlistPage .pdetail-cover img, #playlistPage .pdetail-small-cover img")
                .forEach(img => { img.src = portada; });
            actualizarMiniaturas();
            await window.SpotifyNetLibraryRefresh?.();
            mensaje("Portada guardada. Permanecerá después de volver a iniciar sesión.");
        } catch (error) { mensaje(error.message, true); }
    });
    cargarCanciones();

});
</script>
}
