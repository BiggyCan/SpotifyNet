    async function cambiarFavorito(cancion) {
        try {
            if (cancion.isLiked) {
                await peticionPost(
                    "/Biblioteca/QuitarDeLista",
                    {
                        id: cancion.id,
                        slug: "tus-me-gusta"
                    }
                );

                mensaje("Canción quitada de Tus me gusta.");
            } else {
                await peticionPost(
                    "/Biblioteca/AgregarALista",
                    {
                        id: cancion.id,
                        slug: "tus-me-gusta"
                    }
                );

                mensaje("Canción añadida a Tus me gusta.");
            }

            cerrarMenus();
            await cargarCanciones(false);

        } catch (error) {
            mensaje(error.message, true);
        }
    }

    async function agregarALista(cancion, destino) {
        try {
            const resultado = await peticionPost(
                "/Biblioteca/AgregarALista",
                {
                    id: cancion.id,
                    slug: destino
                }
            );

            cerrarMenus();

            mensaje(
                resultado.message ||
                "Canción añadida a la playlist."
            );

            if (destino === "tus-me-gusta") {
                await cargarCanciones(false);
            }

        } catch (error) {
            mensaje(error.message, true);
        }
    }

